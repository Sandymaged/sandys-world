# من Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# سري — للسيرفر بس، متتحطش في أي مكان عام
SUPABASE_SECRET_KEY=sb_secret_...

# مساعد الهدايا (Claude): من console.anthropic.com → API Keys
# من غيره المساعد بيشتغل بقواعد بسيطة
ANTHROPIC_API_KEY=sk-ant-...

# كلمة سر لوحة التحكم — لازم تتحط على الاستضافة، من غيرها اللوحة بتتقفل
ADMIN_PASSWORD=
# (اختياري) مفتاح توقيع جلسة اللوحة؛ لو مش موجود بيتعمل من كلمة السر
ADMIN_SECRET=

# بيانات إنستاباي اللي بتظهر للعميل في صفحة الدفع
INSTAPAY_ADDRESS=
INSTAPAY_LINK=
INSTAPAY_NAME=
